{
  "manifest_version": 3,
  "name": "Timeless",
  "version": "__TIMELESS_VERSION__",
  "description": "Local-first research and writing workspace with structured sources, citations, native XML, and PDF export.",
  "homepage_url": "https://github.com/MoonlightClarity/Timeless",
  "browser_specific_settings": {
    "gecko": {
      "id": "timeless@moonlightclarity",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "action": {
    "default_title": "Open Timeless",
    "default_icon": {
      "48": "icon-48.png",
      "96": "icon-96.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
